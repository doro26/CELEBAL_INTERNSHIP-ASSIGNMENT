                "variables": {
                    "filterdataitems": {
                        "type": "String",
                        "defaultValue": "@filter(activity('getmetadataaweek7').output.childItems, item().name matches 'CUST MSTR .*\\.csv')"
                    }
                },
                "annotations": [],
                "lastPublishTime": "2025-07-19T19:10:43Z"
            },
            "dependsOn": [
